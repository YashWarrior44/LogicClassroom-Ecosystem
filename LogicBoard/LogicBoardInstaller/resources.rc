// resources.rc — everything the installer needs to be a single-file EXE.
//
// The .rc compiler bakes these payloads into the final binary. At install
// time the C++ code pulls them back out via FindResource / LoadResource /
// LockResource without ever touching the disk except to write the extracted
// files into Program Files.
//
// Numeric IDs matter — they must match the constants in
// LogicBoardInstaller.cpp (100 = icon group, 101 = individual icon,
// 102 = raw icon bytes, LOGICBOARD_ZIP = named payload).

#include <windows.h>

// -----------------------------------------------------------------------------
// App icon — 100 is the "icon group" resource that Windows picks up
// automatically for the taskbar / Alt-Tab thumbnail. The raw .ico bytes
// are ALSO embedded a second time as RCDATA (id 102) so the installer
// can drop a copy on disk for shortcuts and Apps & Features to reference.
// -----------------------------------------------------------------------------
100 ICON "logo.ico"
102 RCDATA "logo.ico"

// -----------------------------------------------------------------------------
// The LogicBoard payload — everything the ZIP contains gets extracted into
// C:\Program Files\LogicBoard\ during install.
// -----------------------------------------------------------------------------
LOGICBOARD_ZIP RCDATA "LogicBoard.zip"

// -----------------------------------------------------------------------------
// Version block — helps Windows show sensible metadata in File Properties
// and the smart-screen prompt. Bump when the installer version changes.
// -----------------------------------------------------------------------------
1 VERSIONINFO
FILEVERSION     3,1,3,0
PRODUCTVERSION  3,1,3,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LogicClassroom"
            VALUE "FileDescription",  "LogicBoard Installer"
            VALUE "FileVersion",      "3.1.3"
            VALUE "InternalName",     "LogicBoardInstaller"
            VALUE "OriginalFilename", "LogicBoardInstaller.exe"
            VALUE "ProductName",      "LogicBoard"
            VALUE "ProductVersion",   "3.1.3"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Yash Jain. Licensed under GPL-3.0."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
