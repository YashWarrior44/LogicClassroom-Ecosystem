<?xml version="1.0" encoding="utf-8"?>
<!--
  LogicShare's logo, hand-converted from assets/logo.svg (byte-identical to
  LogicShare Windows' LogicShare.svg). Same 256-unit canvas, same paths, same
  gradients; SVG's objectBoundingBox gradient units are resolved to absolute
  coordinates here because vector drawables only take user-space ones.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="256dp"
    android:height="256dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

    <!-- App-tile background -->
    <path android:pathData="M56,0 H200 A56,56 0 0 1 256,56 V200 A56,56 0 0 1 200,256 H56 A56,56 0 0 1 0,200 V56 A56,56 0 0 1 56,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0"
                android:endX="256" android:endY="256">
                <item android:offset="0" android:color="#FF7CD0FF" />
                <item android:offset="1" android:color="#FF2596E3" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top sheen for depth -->
    <path android:pathData="M56,0 H200 A56,56 0 0 1 256,56 V72 A56,56 0 0 1 200,128 H56 A56,56 0 0 1 0,72 V56 A56,56 0 0 1 56,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0"
                android:endX="0" android:endY="128">
                <item android:offset="0" android:color="#38FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Wireless waves -->
    <path android:pathData="M44,92 Q8,140 44,188"
        android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.55"
        android:strokeWidth="7" android:strokeLineCap="round" />
    <path android:pathData="M62,112 Q40,140 62,168"
        android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.88"
        android:strokeWidth="7" android:strokeLineCap="round" />

    <!-- Soft ground shadow under the plane -->
    <path android:pathData="M90,218 A58,6 0 1 0 206,218 A58,6 0 1 0 90,218 Z"
        android:fillColor="#1D4F78" android:fillAlpha="0.18" />

    <!-- Paper plane bottom (shaded) face: bbox y 150..220 -->
    <path android:pathData="M74,150 L134,172 L182,220 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="150"
                android:endX="0" android:endY="220">
                <item android:offset="0" android:color="#FFA8D4EE" />
                <item android:offset="1" android:color="#FF4F93C4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Paper plane top (lit) face: bbox x 74..222 -->
    <path android:pathData="M74,150 L222,54 L134,172 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="74" android:startY="0"
                android:endX="222" android:endY="0">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFDCECFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crease highlight -->
    <path android:pathData="M74,150 L134,172"
        android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.6" android:strokeWidth="1" />
</vector>
